# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-long-random-value"

# Prefer the NAS Tailscale MagicDNS name when all access is through Tailscale.
NEXTAUTH_URL="http://your-ugreen-tailscale-name:3000"

ICOST_PORT="3000"
ICOST_DATABASE_DIR="/volume1/docker/icost/database"
ICOST_IMPORT_DIR="/volume1/docker/icost/imports"
TZ="America/New_York"
